{
  "manifest_version": 3,
  "name": "Neo's New Tab",
  "version": "3.55.0",
  "description": "A high-performance Matrix-style new tab dashboard with customizable visuals and Sentinel Swarm.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "search",
    "system.cpu",
    "system.memory"
  ],
  "host_permissions": [
    "https://www.reddit.com/*",
    "https://*.puter.com/*",
    "https://text.pollinations.ai/*",
    "https://en.wikipedia.org/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; frame-src https://eyes.nasa.gov https://discord.com https://github.com https://quantumvoidd.github.io blob: data:;",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; script-src-elem 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' blob:; child-src 'self' blob:;"
  },
  "sandbox": {
    "pages": [
      "sandbox.html",
      "emulator_sandbox.html",
      "snes_sandbox.html",
      "gba_sandbox.html",
      "psx_sandbox.html",
      "nes_sandbox.html",
      "Emulators/sms/sms_sandbox.html",
      "Emulators/gbc/gbc_sandbox.html",
      "Arcade/space_invaders/spaceinvaders_sandbox.html",
      "Arcade/pacman/pacman_sandbox.html",
      "Arcade/mspacman/mspacman_sandbox.html",
      "Arcade/frogger/frogger_sandbox.html",
      "Arcade/asteroids/asteroids_sandbox.html",
      "Arcade/donkeykong/donkeykong_sandbox.html",
      "Games/matrixrampage/rampage.html",
      "Games/matrixrampage2/rampage2.html",
      "Games/matrixpandemonium/pandemonium.html",
      "Games/citizensofzion/citizensofzion.html",
      "Games/matrixdockdefence/matrixdockdefence.html",
      "Games/matrixoverloaded/matrixoverloaded.html",
      "Games/matrixtunnelrecon/matrixtunnelrecon.html",
      "Games/matrixbullettime/bullettime.html",
      "Games/matrixfighter/matrixfighter.html"
    ]
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "oracle-engine.js",
        "sentinel.webm",
        "journey2.mp4",
        "matrix_binary_tunnel.mp4",
        "matrix_class_room.mp4",
        "matrix_movie_tunnel.mp4",
        "matrix_room.mp4",
        "combat_training.mp4",
        "meditation.mp4",
        "operator.mp4",
        "puter.js",
        "scripts/puter.js",
        "typewriter-key.mp3",
        "glitch.mp3",
        "jackin.mp3",
        "ringing.mp3",
        "hangup.mp3",
        "phone_msg_1.mp3",
        "phone_msg_2.mp3",
        "phone_msg_3.mp3",
        "phone_msg_4.mp3",
        "phone_msg_5.mp3",
        "phone_msg_6.mp3",
        "phone_msg_7.mp3",
        "phone_msg_8.mp3",
        "phone_msg_9.mp3",
        "phone_msg_10.mp3",
        "phone_msg_11.mp3",
        "rain_window.mp3",
        "hum.mp3",
        "matrix_code.mp3",
        "sentinel_swarm.mp3",
        "Games/game.html",
        "Games/*.swf",
        "Games/*.xml",
        "Games/*.sqlite",
        "Games/*.js",
        "Ruffle/ruffle.js",
        "Ruffle/*.wasm",
        "Emulators/gba/*",
        "Emulators/gba/roms/*",
        "Emulators/gbc/*",
        "Emulators/gbc/roms/*",
        "Emulators/gbc/gbc-controller.js",
        "Emulators/gbc/cover.jpg",
        "Emulators/gbc/gbc_sandbox.html",
        "Emulators/nes/*",
        "Emulators/nes/roms/*",
        "Emulators/nes/nes-controller.js",
        "Emulators/nes/nostalgist.umd.min.js",
        "Emulators/nes/cover.jpg",
        "Emulators/sms/gearsystem_libretro.js",
        "Emulators/sms/gearsystem_libretro.wasm",
        "Emulators/sms/sms_sandbox.html",
        "Emulators/sms/nostalgist.umd.min.js",
        "Emulators/sms/roms/*",
        "Emulators/sms/sms-controller.js",
        "Emulators/sms/cover.jpg",
        "Emulators/genesis/nostalgist.umd.min.js",
        "Emulators/genesis/genesis-controller.js",
        "Emulators/genesis/cores/*",
        "Emulators/genesis/roms/*",
        "Emulators/genesis/data/*",
        "Emulators/snes/cores/*",
        "Emulators/snes/roms/*",
        "Emulators/snes/snes-controller.js",
        "Emulators/snes/cover.jpg",
        "Emulators/psx/*",
        "Emulators/psx/roms/*",
        "Emulators/psx/psx-controller.js",
        "Emulators/psx/cover.jpg",
        "snes_sandbox.html",
        "gba_sandbox.html",
        "psx_sandbox.html",
        "nes_sandbox.html",
        "Arcade/space_invaders/*",
        "Arcade/pacman/*",
        "Arcade/mspacman/*",
        "Arcade/frogger/*",
        "Arcade/asteroids/*",
        "Arcade/donkeykong/*",
        "Games/matrixrampage/*",
        "Games/matrixrampage2/*",
        "Games/matrixpandemonium/*",
        "Games/citizensofzion/*",
        "Games/matrixdockdefence/*",
        "Games/matrixoverloaded/*",
        "Games/matrixtunnelrecon/*",
        "Games/matrixbullettime/*",
        "Games/matrixfighter/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}