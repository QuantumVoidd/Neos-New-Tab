{
  "manifest_version": 3,
  "name": "Neo's New Tab",
  "version": "3.32.0",
  "description": "A high-performance Matrix-style new tab dashboard with customizable visuals and Sentinel Swarm.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "search",
    "system.cpu",
    "system.memory"
  ],
  "host_permissions": [
    "https://www.reddit.com/*",
    "https://*.puter.com/*",
    "https://text.pollinations.ai/*",
    "https://en.wikipedia.org/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; frame-src https://eyes.nasa.gov;"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "oracle-engine.js",
        "sentinel.webm",
        "journey2.mp4",
        "matrix_binary_tunnel.mp4",
        "matrix_class_room.mp4",
        "matrix_movie_tunnel.mp4",
        "matrix_room.mp4",
        "combat_training.mp4",
        "meditation.mp4",
        "operator.mp4",
        "puter.js",
        "scripts/puter.js",
        "typewriter-key.mp3",
        "glitch.mp3",
        "jackin.mp3",
        "ringing.mp3",
        "hangup.mp3",
        "phone_msg_1.mp3",
        "phone_msg_2.mp3",
        "phone_msg_3.mp3",
        "phone_msg_4.mp3",
        "phone_msg_5.mp3",
        "phone_msg_6.mp3",
        "phone_msg_7.mp3",
        "phone_msg_8.mp3",
        "phone_msg_9.mp3",
        "phone_msg_10.mp3",
        "phone_msg_11.mp3",
        "rain_window.mp3",
        "hum.mp3",
        "matrix_code.mp3",
        "sentinel_swarm.mp3",
        "Games/game.html",
        "Games/*.swf",
        "Games/*.xml",
        "Games/*.sqlite",
        "Games/*.js",
        "Ruffle/ruffle.js",
        "Ruffle/*.wasm"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}